{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}

<section class="section section-padding">
    <div class="container">

        <h1 class="section-title text-center mb-5">Mon panier</h1>

        {% if cartItems is empty %}
            <p class="section-text text-center">
                Votre panier est vide 
            </p>
        {% else %}

        <div class="table-responsive">
            <table class="table table-dark table-bordered text-center align-middle">

                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Image</th>
                        <th>Prix</th>
                        <th>Quantité</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>
                    {% for item in cartItems %}
                        <tr>
                            <td>{{ item.product.name }}</td>

                            <td>
                                <img src="{{ asset('uploads/products/' ~ item.product.image) }}"
                                     style="width:80px; height:80px; object-fit:cover;">
                            </td>

                            <td>{{ item.product.price }} DH</td>

                            <td>{{ item.quantity }}</td>

                            <td>{{ item.subtotal }} DH</td>
                        </tr>
                    {% endfor %}
                </tbody>

            </table>
        </div>

        <h3 class="text-end mt-4">
            Total : <span class="text-purple">{{ total }} DH</span>
        </h3>

        {% endif %}

        <div class="text-center mt-4">
            <a href="{{ path('app_home') }}" class="btn btn-primary">
                Continuer mes achats
            </a>
        </div>

    </div>
</section>

{% endblock %}