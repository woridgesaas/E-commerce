{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5">
    <h2>Documentation produits</h2>

    <div class="row">
        {% for doc in docs %}
            <div class="col-md-4 mb-4">
                <div class="card p-3">

                    <h5>{{ doc.title }}</h5>

                    <p>{{ doc.summary }}</p>

                    <a href="{{ path('documentation_by_product', {productId: doc.productId|number_format(0)}) }}" 
                       class="btn btn-primary">
                        Voir documentation
                    </a>

                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}