{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title mb-0">Gestion des produits</h2>
        <a href="{{ path('admin_product_add') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Ajouter
        </a>
    </div>

    {% for message in app.flashes('success') %}
    <div class="alert alert-success">
        {{ message }}
    </div>
{% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger">{{ msg }}</div>
    {% endfor %}

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nom</th>
                <th>Type</th>
                <th>Description</th>
                <th>Prix (MAD)</th>
                <th>Statut</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.name }}</td>
                <td>{{ product.type.label() }}</td>       {# ← label lisible de l'enum #}
                <td>{{ product.description|slice(0, 60) }}…</td>
                <td>{{ product.price|number_format(2, ',', ' ') }}</td>
                <td>
                    <span class="badge {{ product.status.value == 'ACTIVE' ? 'bg-success' : 'bg-secondary' }}">
                        {{ product.status.value }}
                    </span>
                </td>
        <td style="overflow: hidden; width: 80px;">
    {% if product.image %}
        <img src="{{ asset('uploads/products/' ~ product.image) }}"
             class="table-img"
             data-bs-toggle="modal"
             data-bs-target="#imgModal{{ product.id }}"
             alt="{{ product.name }}">
    {% else %}
        <span class="text-muted">—</span>
    {% endif %}
</td>
                <td>
                    <a href="{{ path('admin_product_edit', {id: product.id}) }}"
                       class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <button class="btn btn-danger btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal{{ product.id }}">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted py-4">Aucun produit.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% for product in products %}
<div class="modal fade" id="deleteModal{{ product.id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-0">
            <div class="modal-header border-0">
                <h5 class="modal-title">Confirmation</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p>Supprimer <strong>{{ product.name }}</strong> ?</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post"
                      action="{{ path('admin_product_delete', {id: product.id}) }}">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('delete' ~ product.id) }}">
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endfor %}
{% for product in products %}
<div class="modal fade" id="imgModal{{ product.id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-0">
            <div class="modal-body p-0 text-center">
                <img src="{{ asset('uploads/products/' ~ product.image) }}"
                     class="w-100"
                     style="max-height: 80vh; object-fit: contain;">
            </div>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}