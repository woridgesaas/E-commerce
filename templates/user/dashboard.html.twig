{% extends 'base.html.twig' %}

{% block title %}Mon espace{% endblock %}

{% block body %}

<div class="container py-5">

    <h1 class="section-title mb-3">Mon espace</h1>
    <p class="section-text">Bienvenue {{ app.user.userIdentifier }}</p>

    <div class="row mt-5">

        <div class="col-md-4">
            <div class="card-custom p-4 text-center">
                <i class="bi bi-cart why-icon"></i>
                <h5 class="mt-3">Mon panier</h5>
                <a href="{{ path('app_cart') }}" class="btn btn-primary mt-3">Voir panier</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-custom p-4 text-center">
                <i class="bi bi-person why-icon"></i>
                <h5 class="mt-3">Mon profil</h5>
                <a href="#" class="btn btn-outline mt-3">Bientôt</a>
            </div>
        </div>

    </div>

</div>

{% endblock %}