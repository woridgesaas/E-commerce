<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Woridge{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
    <style>
        #plans .plan-card {
            background: #ffffff;
            border-radius: 1.5rem;
            padding: 1.8rem 1.5rem 2rem 1.5rem;
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: all 0.25s ease-in-out;
            box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(203, 213, 225, 0.5);
        }

        #plans .plan-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 28px -12px rgba(0, 0, 0, 0.15);
            border-color: rgba(99, 102, 241, 0.3);
        }

        /* Carte Pro (featured) encore plus distinctive */
        #plans .plan-card.featured {
            background: linear-gradient(145deg, #ffffff 0%, #faf9ff 100%);
            border-top: 4px solid #8B5CF6;
            box-shadow: 0 18px 30px -12px rgba(139, 92, 246, 0.2);
        }

        /* Badge populaire */
        #plans .badge-plan {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: linear-gradient(135deg, #8B5CF6, #A855F7);
            color: white;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 0.3rem 1rem;
            border-radius: 3rem;
            margin-bottom: 1rem;
            width: fit-content;
            letter-spacing: 0.3px;
        }

        /* Titres des plans */
        #plans .plan-card h4 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 1.2rem;
            color: #0f172a;
            border-left: 4px solid;
            padding-left: 0.9rem;
            line-height: 1.2;
        }
        #plans .plan-card:nth-child(1) h4 { border-left-color: #3b82f6; }
        #plans .plan-card.featured h4 { border-left-color: #8B5CF6; }
        #plans .plan-card:last-child h4 { border-left-color: #1e293b; }

        /* Liste des fonctionnalités */
        #plans .plan-card ul {
            list-style: none;
            padding-left: 0;
            margin-bottom: 1.2rem;
            flex-grow: 0;
        }
        #plans .plan-card li {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin-bottom: 0.7rem;
            font-size: 0.95rem;
            font-weight: 500;
            color: #1e293b;
        }
        #plans .plan-card li i {
            font-size: 1.2rem;
            color: #3b82f6;
            min-width: 1.4rem;
        }
        #plans .plan-card.featured li i {
            color: #8B5CF6;
        }
        #plans .plan-card:last-child li i {
            color: #2c3e50;
        }

        /* Description */
        #plans .plan-desc {
            background: #f8fafc;
            padding: 0.9rem 1rem;
            border-radius: 1rem;
            font-size: 0.9rem;
            line-height: 1.5;
            color: #334155;
            margin: 0.2rem 0 1rem 0;
            border: 1px solid #eef2f6;
        }

        /* Durées */
        #plans .plan-duration {
            background: #f1f5f9;
            padding: 0.5rem;
            border-radius: 2rem;
            font-size: 0.8rem;
            font-weight: 500;
            color: #2d3a4b;
            margin: 0.5rem 0 1.2rem 0;
            display: inline-block;
            width: 100%;
            text-align: center;
        }

        /* Boutons */
        #plans .btn {
            font-weight: 600;
            padding: 0.6rem 0.8rem;
            border-radius: 2rem;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
        }
        #plans .btn-outline {
            border: 1.5px solid #cbd5e1;
            background: white;
            color: #1f2a3e;
        }
        #plans .btn-outline:hover {
            background: #3b82f6;
            border-color: #3b82f6;
            color: white;
        }
        #plans .btn-primary {
            background: #8B5CF6;
            border: none;
            box-shadow: 0 4px 10px -4px rgba(139, 92, 246, 0.4);
        }
        #plans .btn-primary:hover {
            background: #7C3AED;
            transform: translateY(-2px);
        }
        #plans .btn-dark {
            background: #1E293B;
            border: none;
        }
        #plans .btn-dark:hover {
            background: #0f172a;
            transform: translateY(-2px);
        }
        #plans .btn:hover i {
            transform: translateX(3px);
        }
        #plans .btn i {
            transition: transform 0.15s;
        }

        /* Ajustement mobile */
        @media (max-width: 768px) {
            #plans .plan-card {
                padding: 1.3rem;
            }
            #plans .plan-card h4 {
                font-size: 1.5rem;
            }
        }
        #plans .duration-chips {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.5rem;
            margin: 0.75rem 0 1.25rem 0;
        }
        #plans .chip {
            background: #f1f5f9;
            color: #1e293b;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.4rem 0.9rem;
            border-radius: 2rem;
            transition: all 0.2s ease;
            cursor: default;
            border: 1px solid #e2e8f0;
            letter-spacing: -0.2px;
        }
        /* Variante plus stylée pour la carte Pro (featured) */
        #plans .plan-card.featured .chip {
            background: #ede9fe;
            border-color: #c4b5fd;
            color: #5b21b6;
        }
        #plans .chip:hover {
            transform: translateY(-1px);
            background: #e2e8f0;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }
        /* Responsive */
        @media (max-width: 576px) {
            #plans .duration-chips {
                gap: 0.4rem;
            }
            #plans .chip {
                font-size: 0.7rem;
                padding: 0.3rem 0.7rem;
            }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

    {% include 'partials/header.html.twig' %}

    {% block body %}{% endblock %}

    {% include 'partials/footer.html.twig' %}

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    {% block scripts  %}{% endblock %}
</body>
</html>
